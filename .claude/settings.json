{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(curl https://sheldonwspence-dev.github.io/*)",
      "Bash(pdftoppm *)",
      "Bash(python3 -m http.server *)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(brew *)",
      "Bash(npm *)",
      "Bash(pip *)",
      "Bash(pip3 *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ]
  }
}
